# Copie este arquivo para .env.local e preencha os valores.
# Variáveis com NEXT_PUBLIC_ ficam visíveis no navegador. Nunca coloque segredos nelas.

# Endereço público do site, sem barra no final. Usado nos metadados e nos links de compartilhamento.
NEXT_PUBLIC_SITE_URL=

# Link de convite da comunidade de WhatsApp, para onde o inscrito é levado depois do cadastro.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=

# ID do vídeo não listado do YouTube com o convite do Dr. Pablo. Vazio: a seção do vídeo some em produção.
NEXT_PUBLIC_VIDEO_CONVITE_ID=

# URL do App da Web do Google Apps Script (termina em /exec). Só no servidor, nunca com NEXT_PUBLIC_.
GOOGLE_SHEETS_WEBHOOK_URL=

# Segredo igual à propriedade SHEETS_SECRET do Apps Script. Só no servidor, nunca com NEXT_PUBLIC_.
SHEETS_SECRET=

# ID do Meta Pixel, usado no navegador para o evento Lead.
NEXT_PUBLIC_META_PIXEL_ID=

# Token da API de Conversões da Meta. Usado só no servidor.
META_CONVERSIONS_API_TOKEN=

# Código de teste do Gerenciador de Eventos da Meta. Deixe vazio em produção.
META_TEST_EVENT_CODE=
