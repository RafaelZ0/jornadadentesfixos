# Copie este arquivo para .env.local e preencha os valores.
# Variáveis com NEXT_PUBLIC_ ficam visíveis no navegador. Nunca coloque segredos nelas.

# Endereço público do site, sem barra no final. Usado nos metadados e nos links de compartilhamento.
NEXT_PUBLIC_SITE_URL=

# Link de convite da comunidade de WhatsApp, para onde o inscrito é levado depois do cadastro.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=

# Link da transmissão da aula no YouTube. O endereço /aula leva para ele. Trocou: republique o site.
NEXT_PUBLIC_YOUTUBE_LIVE_URL=

# Reserva do /live. Os links das 5 lives ficam em src/config/evento.ts (livesAquecimento) e o /live
# escolhe sozinho a live do dia. Esta variável só vale para uma live que ainda não tem link lá.
NEXT_PUBLIC_YOUTUBE_NEXT_LIVE_URL=

# ID do vídeo do replay no YouTube (o trecho depois de v=). Some do site em 26/11 às 22h.
NEXT_PUBLIC_REPLAY_VIDEO_ID=

# WhatsApp do comercial, para o link "Prefere chamar no WhatsApp?" em /vaga. Só dígitos, com 55 e DDD.
# Vazio: usa o WhatsApp da clínica.
NEXT_PUBLIC_WHATSAPP_COMERCIAL=

# URL do App da Web do Google Apps Script (termina em /exec). Só no servidor, nunca com NEXT_PUBLIC_.
GOOGLE_SHEETS_WEBHOOK_URL=

# Segredo igual à propriedade SHEETS_SECRET do Apps Script. Só no servidor, nunca com NEXT_PUBLIC_.
SHEETS_SECRET=

# ID do Meta Pixel, usado só pelo servidor na API de Conversões. Vazio: a API de Conversões não envia.
NEXT_PUBLIC_META_PIXEL_ID=

# ID do Google Tag Manager. Sem a variável, usa GTM-KLKXFHJ6. Vazia: o Tag Manager não carrega.
# O Pixel da Meta no navegador roda só pelo GTM. O site envia os eventos ao dataLayer (lista no README).
NEXT_PUBLIC_GTM_ID=GTM-KLKXFHJ6

# true: o GTM (e o Pixel dentro dele) só carrega depois do "Entendi". false: carrega direto e o aviso só informa. Decisão do jurídico.
NEXT_PUBLIC_PIXEL_REQUIRE_CONSENT=false

# Token da API de Conversões da Meta. Só no servidor, nunca com NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=

# Código da aba Testar eventos do Gerenciador de Eventos. Deixe vazio em produção.
META_TEST_EVENT_CODE=


# Título da primeira tela. Vazio ou "aula": "Aula gratuita: como trocar a dentadura por dentes fixos".
# "promessa": volta o título antigo ("Devolva o seu sorriso..."). Trocou: republique o site.
NEXT_PUBLIC_TITULO_PRIMEIRA_TELA=
